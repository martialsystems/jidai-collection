# Pin LF for sources so Windows checkouts stay consistent.
*                     text=auto
*.c                   text eol=lf
*.cc                  text eol=lf
*.cpp                 text eol=lf
*.cxx                 text eol=lf
*.h                   text eol=lf
*.hh                  text eol=lf
*.hpp                 text eol=lf
*.hxx                 text eol=lf
CMakeLists.txt        text eol=lf
CMakePresets.json     text eol=lf
*.cmake               text eol=lf
*.json                text eol=lf
*.yml                 text eol=lf
*.yaml                text eol=lf
*.md                  text eol=lf
*.py                  text eol=lf
*.sh                  text eol=lf
# Windows scripts: CRLF
*.ps1                 text eol=crlf
*.bat                 text eol=crlf
*.cmd                 text eol=crlf
# binary
*.png                 binary
*.wav                 binary
*.zip                 binary
*.pdf                 binary
*.svg                 text eol=lf
